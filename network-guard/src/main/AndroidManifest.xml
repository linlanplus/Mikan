<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <permission android:name="${applicationId}.CONTROL" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.CONTROL" />
    <application android:label="小橘网络组件" android:allowBackup="false">
        <activity android:name=".ConsentActivity" android:exported="true" android:permission="${applicationId}.CONTROL"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name=".GuardService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE" android:foregroundServiceType="specialUse">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
        </service>
    </application>
</manifest>
