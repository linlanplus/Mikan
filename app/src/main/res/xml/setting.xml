<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">



    <PreferenceCategory app:title="@string/appearance">

        <ListPreference
                app:key="theme_mode"
                app:title="@string/theme"
                app:entries="@array/theme_entries"
                app:entryValues="@array/theme_values"
                app:defaultValue="system"
                app:useSimpleSummaryProvider="true" />

        <ListPreference
                app:key="app_language"
                app:title="@string/language"
                app:entries="@array/language_entries"
                app:entryValues="@array/language_values"
                app:defaultValue="system"
                app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>



        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
                app:key="use_vpn_network"
                app:title="@string/use_vpn_network"
                app:summary="@string/use_vpn_network_summary" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <SwitchPreferenceCompat
                app:key="host_signing_fallback"
                app:title="@string/host_signing_fallback_title"
                app:summary="@string/host_signing_fallback_summary"
                app:defaultValue="false" />

        <SwitchPreferenceCompat
                app:key="freeze_app_instantly"
                app:title="@string/freeze_app_instantly_title"
                app:summary="@string/freeze_app_instantly_summary"
                app:defaultValue="false" />

        <Preference
                android:key="send_logs"
                android:title="@string/send_logs_title"
                android:summary="@string/send_logs_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/about_title">

        <Preference
                android:key="about_authors"
                android:title="@string/about_authors_title"
                android:summary="@string/about_authors_summary" />

        <Preference
                android:key="about_upstream"
                android:title="@string/about_upstream_title"
                android:summary="@string/about_upstream_summary" />

        <Preference
                android:key="check_update"
                android:title="@string/check_update" />

    </PreferenceCategory>

    <Preference
            android:key="footer_contact"
            android:layout="@layout/preference_footer"
            android:title="@string/footer_contact" />

</PreferenceScreen>
